---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

// STARTER_CONTENT: replace the hero artwork and its alt text below, then
// remove this comment.
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A lecture theatre reduced to flat gold and black shapes, rows of seats sweeping past the frame, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Watch one Korean drama a week, from a 2003 royal-court epic to a 2026
    Netflix satire, and treat each as a primary source rather than a
    documentary. Every screening runs the same pass: what the drama gets
    right about its period or setting, and what it invents, and why. You'll
    write a short response most weeks, a close-analysis essay at the
    mid-point, and a final essay comparing two dramas across the semester's
    recurring questions — division, hierarchy, work, gender, status,
    appearance.
  </p>

  <h2>Who it is for</h2>
  <p>
    Second-year undergraduates with an interest in Korean media and no
    background in Korean Studies required. You don't need to have watched
    K-dramas before; you do need to arrive each week having watched the
    assigned episodes, since the discussion assumes it.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
